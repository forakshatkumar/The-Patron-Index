PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/patron-index
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
# Set to the same web client ID as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Optional legacy bearer migration only. Use a strong random value if needed.
JWT_SECRET=
ENABLE_DEMO_ACCOUNT=false


# Optional trusted malware scanning service (NOT the business classifier).
MALWARE_SCAN_URL=
