{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://the-patron-index-backend.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci --include=dev"
}
