# Set these in the SINGLE Vercel project, not in GitHub.
MONGO_URI=
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
# Optional: only for legacy bearer-token migration; random, private.
JWT_SECRET=
# Optional additional trusted origins, comma-separated; same-origin Vercel requests work without it.
FRONTEND_URL=
# Optional malware scanner only; customer RFM scoring is built into the Node API.
MALWARE_SCAN_URL=
