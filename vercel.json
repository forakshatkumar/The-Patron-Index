{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "Frontend",
      "framework": "vite",
      "installCommand": "npm ci --include=dev",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "patron-index-backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "vercel-app.js",
      "installCommand": "npm ci --omit=dev",
      "bindings": [
        {
          "type": "service",
          "service": "patron-index-ml",
          "format": "url",
          "env": "MALWARE_SCAN_URL"
        }
      ]
    },
    "patron-index-ml": {
      "root": "ml",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "patron-index-backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "patron-index-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}